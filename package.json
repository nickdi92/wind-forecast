{
  "name": "wind-forecast",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "pwa-assets-generator",
    "build:native": "tsc --noEmit && vite build --mode native",
    "ios": "npm run build:native && cap sync ios && npm run ios:project",
    "ios:project": "cd ios/App && xcodegen generate",
    "ios:icon": "node scripts/ios-icon.mjs",
    "test:ios": "cd ios/WindCore && swift test"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.3",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0"
  }
}
